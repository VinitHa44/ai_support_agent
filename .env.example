# Server Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Database Path
DB_PATH=data/ampere_support.db

# Documentation Index Path
DOCS_PATH=data/docs/scraped_docs.json

# ---------------- Pinecone Vector DB (Semantic & Hybrid Search) ----------------
# Optional: Pinecone Vector Database API Key & Index
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ampere-docs
EMBEDDING_MODEL=text-embedding-3-small

# Option A: OpenRouter (Recommended - Access OpenAI, Anthropic, Gemini, etc. with 1 key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Option B: Direct OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------- Discord Webhook (Escalation) ----------------
# Optional: Discord webhook URL to receive live tickets (leave blank for mock mode)
DISCORD_WEBHOOK_URL=