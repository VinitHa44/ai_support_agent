# Server Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Database Path
DB_PATH=data/ampere_support.db

# Documentation Index Path
DOCS_PATH=data/docs/scraped_docs.json

# Discord Webhook URL (Leave empty or "mock" to use built-in mock mode)
DISCORD_WEBHOOK_URL=

# ---------------- Pinecone Vector DB (Semantic & Hybrid Search) ----------------
# Optional: Pinecone Vector Database API Key & Index
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ampere-docs
EMBEDDING_MODEL=text-embedding-3-small

# ---------------- LLM Configuration ----------------
# Option A: OpenRouter (Recommended - Access OpenAI, Anthropic, Gemini, etc. with 1 key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option B: Direct OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Option C: Direct Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Option D: Direct Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
